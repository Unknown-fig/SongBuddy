# Environment Mode ('development' or 'production')
ENVIRONMENT="development"

# Cryptographic Secret Key for JWT Token Signing
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="generate-with-secrets.token_urlsafe(32)"

# Server Network Binding
# For development/local host:
HOST="127.0.0.1"
PORT=8000

# For production behind reverse proxy (Docker / Nginx):
# HOST="0.0.0.0"

# TLS / HTTPS Configuration
USE_SSL="false"
SSL_CERT_PATH="server-cert.pem"
SSL_KEY_PATH="server-key.pem"

# API Authentication Enforcement (Set to "true" to require Bearer JWT on endpoints)
REQUIRE_AUTH="false"

# CORS Allowed Origin
CORS_ORIGIN="*"

# Logging Configuration (LOG_LEVEL: DEBUG, INFO, WARNING, ERROR; LOG_FORMAT: text, json)
LOG_LEVEL="INFO"
LOG_FORMAT="text"

# Spotify API Credentials (Optional for web streaming, required for Spot-Extractor metadata)
# Get these at https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID="your_spotify_client_id_here"
SPOTIPY_CLIENT_SECRET="your_spotify_client_secret_here"

# Download Directory for offline export (optional)
DOWNLOAD_DIR="./downloads"
